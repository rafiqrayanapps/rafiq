rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && 
             request.auth.token.email != null && 
             request.auth.token.email_verified == true &&
             (
               request.auth.token.email.lower() == 'artbag.rayanapp@gmail.com' ||
               request.auth.token.email == 'artbag.rayanapp@gmail.com'
             );
    }
    
    function isAdmin() {
      return isSuperAdmin() || (
             isSignedIn() && 
             request.auth.token.email != null &&
             (
               (exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower())) &&
                get(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower())).data.role == 'admin') ||
               (exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email)) &&
                get(/databases/$(database)/documents/whitelist/$(request.auth.token.email)).data.role == 'admin')
             )
      );
    }

    function isEditor() {
      return isSuperAdmin() || (
             isSignedIn() && 
             request.auth.token.email != null &&
             (
               (exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower())) &&
                get(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower())).data.role == 'editor') ||
               (exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email)) &&
                get(/databases/$(database)/documents/whitelist/$(request.auth.token.email)).data.role == 'editor')
             )
      );
    }

    // --- Content Rules ---
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId}/items/{itemId} {
      allow read: if true;
      allow create: if isAdmin() || (isEditor() && request.resource.data.status == 'pending');
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Blog and Posts Rules ---
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Custom Pages Rules ---
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subcategories/{subId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subCategories/{subId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- App Configuration Rules ---
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contacts/{contactId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Push Notifications Tokens ---
    match /fcmTokens/{token} {
      allow read: if isAdmin();
      allow create, update: if true;
      allow delete: if isAdmin();
    }
    
    // --- User Data Rules (Hardened against IDOR & Privilege Escalation) ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'points', 'status', 'createdAt'])) || isAdmin();
      allow delete: if isAdmin();
    }

    match /userStats/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    // --- Whitelist / Roles Rules (Protected against Information Disclosure) ---
    match /whitelist/{email} {
      allow read: if isSignedIn() && (request.auth.token.email.lower() == email.lower() || isAdmin());
      allow write: if isAdmin();
    }
    
    match /used_invitations/{fingerprint} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }
  }
}

